<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Warnings fail the build; NuGet audit advisories stay warnings (cve-scan covers them), so a new advisory
         doesn't break unrelated builds. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>docwizz</ToolCommandName>
    <!-- Official release builds supply -p:Version from the immutable Git tag; any other build derives it from the
         tags (DocWizzGitVersion below), and only a build without git or tags is 0.0.0-dev. -->
    <DocWizzGitVersion Condition="'$(Version)' == ''">true</DocWizzGitVersion>
    <Version Condition="'$(Version)' == ''">0.0.0-dev</Version>
  </PropertyGroup>
  <!-- On a release tag: that version (v0.2.2 → 0.2.2). Commits after it: a pre-release of the next patch, counting the
       commits since the tag (0.2.3-dev.4), so it sorts after the release it builds on and before the next one. -->
  <Target Name="DocWizzGitVersion" BeforeTargets="GetAssemblyVersion;GenerateNuspec" Condition="'$(DocWizzGitVersion)' == 'true'">
    <Exec Command="git describe --tags --long --match &quot;v[0-9]*.[0-9]*.[0-9]*&quot;" WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="true" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" EchoOff="true"
          StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_DocWizzDescribe" />
      <Output TaskParameter="ExitCode" PropertyName="_DocWizzDescribeExit" />
    </Exec>
    <PropertyGroup Condition="'$(_DocWizzDescribeExit)' == '0' and $([System.Text.RegularExpressions.Regex]::IsMatch('$(_DocWizzDescribe)', '^v\d+\.\d+\.\d+-\d+-g[0-9a-f]+$'))">
      <_DocWizzTag>$([System.Text.RegularExpressions.Regex]::Replace('$(_DocWizzDescribe)', '^v(\d+\.\d+\.\d+)-.*$', '$1'))</_DocWizzTag>
      <_DocWizzMinor>$([System.Text.RegularExpressions.Regex]::Replace('$(_DocWizzDescribe)', '^v(\d+\.\d+)\..*$', '$1'))</_DocWizzMinor>
      <_DocWizzPatch>$([System.Text.RegularExpressions.Regex]::Replace('$(_DocWizzDescribe)', '^v\d+\.\d+\.(\d+)-.*$', '$1'))</_DocWizzPatch>
      <_DocWizzSince>$([System.Text.RegularExpressions.Regex]::Replace('$(_DocWizzDescribe)', '^.*-(\d+)-g[0-9a-f]+$', '$1'))</_DocWizzSince>
      <Version Condition="'$(_DocWizzSince)' == '0'">$(_DocWizzTag)</Version>
      <Version Condition="'$(_DocWizzSince)' != '0'">$(_DocWizzMinor).$([MSBuild]::Add($(_DocWizzPatch), 1))-dev.$(_DocWizzSince)</Version>
      <PackageVersion>$(Version)</PackageVersion>
    </PropertyGroup>
  </Target>
  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.4.0" />
    <PackageReference Include="Microsoft.Playwright" Version="1.63.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DocWizz.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Written next to generated HTML so its diagrams render offline (Generation/Html/vendor/README.md). -->
    <EmbeddedResource Include="Generation/Html/vendor/mermaid.min.js" LogicalName="mermaid.min.js" />
  </ItemGroup>
</Project>
